{
  "manifest_version": 3,
  "name": "YŌKAI browser search",
  "version": "1.0.0",
  "description": "Search Brave history from your YŌKAI desktop.",
  "key": "",
  "permissions": [
    "history",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "YŌKAI browser search"
  },
  "icons": {
    "128": "icon.png"
  }
}
