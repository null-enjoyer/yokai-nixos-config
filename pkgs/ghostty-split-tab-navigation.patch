+test "SplitTree: spatial navigation preserves tab fallback at horizontal edges" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var left_view: TestTree.View = .{ .label = "left" };
+    var left_tree: TestTree = try .init(alloc, &left_view);
+    defer left_tree.deinit();
+    var right_view: TestTree.View = .{ .label = "right" };
+    var right_tree: TestTree = try .init(alloc, &right_view);
+    defer right_tree.deinit();
+    var split = try left_tree.split(alloc, .root, .right, 0.5, &right_tree);
+    defer split.deinit();
+    const left = split.nodes[0].split.left;
+    const right = split.nodes[0].split.right;
+
+    // Adjacent splits win, while either outer edge permits the tab fallback.
+    try testing.expectEqual(right, (try split.goto(alloc, left, .{ .spatial_no_wrap = .right })).?);
+    try testing.expectEqual(left, (try split.goto(alloc, right, .{ .spatial_no_wrap = .left })).?);
+    try testing.expectEqual(null, try split.goto(alloc, left, .{ .spatial_no_wrap = .left }));
+    try testing.expectEqual(null, try split.goto(alloc, right, .{ .spatial_no_wrap = .right }));
+
+    // A single pane also permits tab navigation in both directions.
+    try testing.expectEqual(null, try left_tree.goto(alloc, .root, .{ .spatial_no_wrap = .left }));
+    try testing.expectEqual(null, try left_tree.goto(alloc, .root, .{ .spatial_no_wrap = .right }));
+
+    // Callers that request wrapping retain their existing behavior.
+    try testing.expectEqual(right, (try split.goto(alloc, left, .{ .spatial = .left })).?);
+    try testing.expectEqual(left, (try split.goto(alloc, right, .{ .spatial = .right })).?);
+}
